# MetalRadar 后端环境配置
APP_NAME=MetalRadar API
APP_VERSION=0.1.0
DEBUG=true

# SQLite 本地开发 (无需 PostgreSQL)
DATABASE_URL=sqlite:///./metalradar.db

# Redis (本地开发关闭)
REDIS_ENABLED=false

# AI/LLM 配置 (Sprint 3 启用)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# CORS
CORS_ORIGINS=["http://localhost:5173"]
