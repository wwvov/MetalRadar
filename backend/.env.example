# MetalRadar 后端环境配置
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env

APP_NAME=MetalRadar API
APP_VERSION=0.1.0
DEBUG=true

# SQLite 本地开发 (无需 PostgreSQL)
DATABASE_URL=sqlite:///./metalradar.db

# Redis (本地开发关闭)
REDIS_ENABLED=false

# AI/LLM 配置
# 支持 OpenAI / DeepSeek / 其他兼容接口
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# CORS
CORS_ORIGINS=["http://localhost:5173"]
